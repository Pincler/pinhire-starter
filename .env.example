# Settings for server.js
#
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the 5 PINHIRE_ values below. Copy each one from the
#    Part 2 card on the PinHire test page.
# 3. Start the server:  node --env-file=.env server.js
#
# Never put your real .env file in Git. It has your secret seed token.
# (.gitignore already keeps .env out of Git.)
#
# If you click "Get a new seed", your seed, refund limit and lock time change.
# Copy all 5 values again. Then update .env (and your hosting settings) and
# start the server again.

# The port on your computer. Online, your hosting service sets PORT for you.
PORT=4300

# Copy the "Seed" at the top of the Part 2 card. It looks like SEED-1234-PH-AB12.
# Paste only the seed. No quotes, no spaces.
# It is the secret key for your signatures. Do not share it.
PINHIRE_SEED_TOKEN=

# Copy the header name from line 1 of the card ("Verify header"). It looks like x-pinhire-hmac-1234.
PINHIRE_SIGNATURE_HEADER=

# Copy the field name from line 2 of the card ("Idempotency lock on payload.tx_ref_1234").
# Write only the part after "payload.", like tx_ref_1234.
PINHIRE_TX_FIELD=

# Copy the refund limit from line 3 of the card ("Never refund more than 240 AED").
# Write only the number, like 240.
PINHIRE_REFUND_CAP_AED=

# Copy the lock time from line 2 of the card ("TTL: 120s").
# Write only the number of seconds, like 120.
PINHIRE_IDEMPOTENCY_TTL_SEC=
