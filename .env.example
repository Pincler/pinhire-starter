# ============================================================================
# PinHire by Pincler — Production AI Boilerplate Environment Template
# Copy this file to .env and populate secrets via Vault / Secret Manager.
# NEVER commit a real .env file to Git!
# ============================================================================

PORT=4300
NODE_ENV=development

# Upstream Model Provider Keys (Server-Side Only!)
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# State & Vector Stores
REDIS_URL=redis://127.0.0.1:6379
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/pinhire_ai

# Webhook & Security Secrets
WEBHOOK_HMAC_SECRET=whsec_replace_with_32_byte_random_hex
DAILY_TENANT_TOKEN_LIMIT=100000
